[resource]
script = ExtResource("2_map_script")
map_id = "oakhaven_crusade"
map_name = "OAKHAVEN LOWLANDS - CRUSADE"
bg_texture = ExtResource("3_bg")
tutorial_title = "CRUSADE MAP NAVIGATION"
tutorial_text = "Ascend through the lowlands toward the Granary:
- Choose your path upwards along connected routes.
- ⚔️ Skirmish: Battle militia scouts for souls.
- 💀 Elite: Face dangerous Templar inquisitors.
- 📜 Grimoire Shrine: Claim forbidden spells.
- 🕯️ Bone Altar: Sacrifice, Transmute, or Heal.
- 👑 Granary: Breaching the fortress completes Chapter 1."
