map_name = "THE MOURNING CRAGS - CRUSADE"
bg_texture = ExtResource("3_bg")
tutorial_title = "CRUSADE: THE MOURNING CRAGS"
tutorial_text = "Ascend the mountain passes toward the High Citadel:
- Fight through royal Inquisition patrols and Templar outposts.
- Claim forbidden dark knowledge and sacrifice souls at altars.
- Breach the mountain fortress to face High Inquisitor Malakor."
